  "narrative": {
    "northStar": "The Quiet Monitoring Desk",
    "overview": "A quiet black workspace for watching accounts and responding when a post arrives. Neutral surfaces, compact sans-serif controls, and generous unoccupied space keep monitoring calm and useful. Color appears only when it communicates operational state.\n\nThis system records the user-approved black one-page direction and the implemented interface. It supersedes the earlier green-and-ivory editorial direction. The desktop and mobile empty states are evidenced by the current review captures; there is no decorative imagery or visual-comp dependency.",
    "keyCharacteristics": [
      "Neutral black field with restrained gray hierarchy.",
      "Account chips above the workspace; persistent status and actions below.",
      "Quiet centered monitoring state and same-page settings revealed on demand.",
      "Flat surfaces, thin separators, and explicit operational status."
    ],
    "rules": [
      {
        "name": "The Neutral Field Rule",
        "body": "Keep navigation and primary actions neutral; reserve chromatic color for operational status.",
        "section": "colors"
      },
      {
        "name": "The Quiet State Rule",
        "body": "Let empty space carry the monitoring state; add explanatory text only when the user needs to act.",
        "section": "typography"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "Use thin dividers and tonal surfaces for structure; reserve shadows for temporary overlays and feedback.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the main field quiet while monitoring has no posts to show.",
      "Do use color sparingly for status and keep its meaning in adjacent text.",
      "Do preserve keyboard focus, accessible icon labels, and truthful paused, disconnected, and error states.",
      "Do retain horizontal account scrolling and footer safe-area spacing on narrow screens."
    ],
    "donts": [
      "Don't restore the obsolete green-and-ivory palette, serif headings, or sidebar layout.",
      "Don't introduce decorative imagery, hero copy, or card grids into the monitoring field.",
      "Don't imply that opening X confirms publication or that monitoring continues when the server is unavailable."
    ]
  }
