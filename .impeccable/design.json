      "css": ".ds-label{display:block;margin:0 0 7px;color:var(--text,#ededed);font:14px/1.5 Inter,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}.ds-field{width:100%;min-height:43px;padding:11px 12px;border:1px solid #383838;border-radius:8px;background:var(--surface,#111);color:var(--text,#ededed);font:16px/1.5 Inter,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;caret-color:white}.ds-field::placeholder{color:#919191}.ds-field:focus-visible{outline:2px solid var(--focus,#ddd);outline-offset:4px}"
